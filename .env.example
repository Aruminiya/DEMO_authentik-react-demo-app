# Demo 應用程式的環境變數範例檔案。
VITE_DEMO_APP_NAME=authentik-react-demo-app

# 展示模式：product（預設，維持現在單一產品的畫面）或 portal（登入後多顯示一張
# 「其他產品」卡片，示範 docs/bon-portal-sso-logout-design.md 附錄確認過的
# Launcher／整頁導頁模式）。
VITE_DEMO_APP_TYPE=product

# 選填，只有 VITE_DEMO_APP_TYPE=portal 時才會用到：其他產品的網址，逗號分隔，
# 不用填名稱——畫面上顯示的名稱會直接取自每個網址的 host（例如 localhost:6175）。
# 範例對應 docker-compose.yml 裡的 bonsale-demo（:6175）/ bontalk-demo（:6176）。
VITE_PORTAL_PRODUCTS=http://localhost:6175,http://localhost:6176,http://localhost:6177

# 選填：切換 src/theme.ts 的主色（MUI palette.primary.main）。可用值見
# THEME_COLORS：default（#fd4b2d，預設）、blue（#1976d2）、green（#2e7d32）；
# 沒填或填到不存在的值都會安全 fallback 回 default，不會噴錯。
VITE_THEME_COLOR=default

# Authentik 應用程式（OAuth2/OIDC 供應商）設定。
# 到 authentik 後台：應用程式 > 供應商 >（你的供應商）查看這些值。
VITE_AUTHENTIK_AUTHORITY=http://localhost:9000/application/o/authentik-react-demo-app/
VITE_AUTHENTIK_CLIENT_ID=change-me
VITE_AUTHENTIK_REDIRECT_URI=http://localhost:5174/login
VITE_AUTHENTIK_POST_LOGOUT_REDIRECT_URI=http://localhost:5174/login
VITE_AUTHENTIK_SCOPE=openid profile email
# 選填：Authentik 註冊流程（Enrollment Flow）的網址（流程與階段 > 流程，使用目的選「Enrollment」）。
# 設定後，登入頁會顯示一個「前往註冊」的連結。
VITE_AUTHENTIK_ENROLLMENT_URL=http://localhost:9000/if/flow/authentik-react-demo-app-enrollment/
